# Copy to .env and fill in. Never commit .env.

# Server (optional locally; Render sets PORT itself)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
RESPONSE_BUDGET_MS=1500         # ms before answering Discord with "thinking…" (limit 3000); set to 1 to test the deferred path

# Discord — Developer Portal > your app
DISCORD_APPLICATION_ID=        # General Information > Application ID
DISCORD_PUBLIC_KEY=            # General Information > Public Key (verifies request signatures)
DISCORD_BOT_TOKEN=             # Bot > Reset Token (secret: bot's password for REST calls)

# Database — Neon > Connect
# Use sslmode=verify-full (not require): pg will weaken `require` to libpq semantics in its next major version.
DATABASE_URL=                  # pooled connection string (host contains -pooler), used by the app
DIRECT_URL=                    # direct (non-pooled) connection string, used by Prisma migrations (prisma.config.ts)
