# Copy to .env and fill in. Never commit .env.

# Discord — Developer Portal > your app
DISCORD_APPLICATION_ID=        # General Information > Application ID
DISCORD_PUBLIC_KEY=            # General Information > Public Key (verifies request signatures)
DISCORD_BOT_TOKEN=             # Bot > Reset Token (secret: bot's password for REST calls)

# Database — Neon > Connect
DATABASE_URL=                  # pooled connection string (host contains -pooler), used by the app
DIRECT_URL=                    # direct (non-pooled) connection string, used by Prisma migrations
